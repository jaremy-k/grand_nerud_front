# Backend API base URL
# Local backend: http://localhost:5003
# Production: https://appgrand.worldautogroup.ru
VITE_API_URL=http://localhost:5003

# Cookie domain in production (development uses localhost automatically)
VITE_COOKIE_DOMAIN=.worldautogroup.ru
