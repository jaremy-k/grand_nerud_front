# Copy to .env.local for local development:
# cp .env.example .env.local

# Backend API base URL (must include http:// or https://)
# Local backend (Docker): http://localhost:5007
# Production: https://api.crm-grandnerudgroup.ru
VITE_API_URL=http://localhost:5007

# Cookie domain in production (development uses localhost automatically)
VITE_COOKIE_DOMAIN=.crm-grandnerudgroup.ru
