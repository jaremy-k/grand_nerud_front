# Copy to .env.local for local development:
# cp .env.example .env.local

# Backend API base URL
# Local backend (Docker): http://localhost:5007
# Production: https://appgrand.worldautogroup.ru
VITE_API_URL=http://localhost:5007

# Cookie domain in production (development uses localhost automatically)
VITE_COOKIE_DOMAIN=.worldautogroup.ru
